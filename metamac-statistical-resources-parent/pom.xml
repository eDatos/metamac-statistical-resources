<?xml version="1.0" encoding="UTF-8" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.siemac.metamac</groupId>
		<artifactId>metamac-parent</artifactId>
		<version>5.2.1</version>
		<relativePath />
	</parent>


	<groupId>org.siemac.metamac.metamac-statistical-resources</groupId>
	<artifactId>metamac-statistical-resources-parent</artifactId>
	<version>11.5.2-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>METAMAC :: STATISTICAL RESOURCES :: PARENT</name>
	<description>METAMAC :: STATISTICAL RESOURCES :: PARENT</description>

	<issueManagement>
		<system>Jira</system>
		<url>http://jira.arte-consultores.com/browse/METAMAC</url>
	</issueManagement>

	<repositories>
		<repository>
			<id>smartclient</id>
			<name>smartclient.com</name>
			<url>http://www.smartclient.com/maven2</url>
		</repository>
	</repositories>

	<properties>
		<metamac-statistical-resources-rest-api-common.version>2.14.1</metamac-statistical-resources-rest-api-common.version>
		<metamac-common-metadata-rest-external-api.version>4.6.2</metamac-common-metadata-rest-external-api.version>
		<metamac-core-common.version>8.12.0</metamac-core-common.version>
		<metamac-rest-api.version>2.3.2</metamac-rest-api.version>
		<metamac-rest-common.version>2.10.0</metamac-rest-common.version>
		<metamac-srm-rest-internal-api.version>3.7.1</metamac-srm-rest-internal-api.version>
		<metamac-srm-rest-external-api.version>3.8.1</metamac-srm-rest-external-api.version>
		<metamac-sso-client.version>5.3.0</metamac-sso-client.version>
		<metamac-statistical-operations-rest-internal-api.version>4.2.1</metamac-statistical-operations-rest-internal-api.version>
		<metamac-statistical-operations-rest-external-api.version>5.2.1</metamac-statistical-operations-rest-external-api.version>
		<metamac-sdmx-data-rest-external-api.version>2.0.0</metamac-sdmx-data-rest-external-api.version>
		<metamac-web-common.version>5.20.0</metamac-web-common.version>
		<metamac-notifications-rest-internal-api.version>3.10.1</metamac-notifications-rest-internal-api.version>
    	<metamac-srm-kafka.version>7.0.0</metamac-srm-kafka.version>
    	<metamac-statistical-operations-kafka.version>5.1.2</metamac-statistical-operations-kafka.version>



		<metamac-statistical-resources.baseDir>${basedir}/..</metamac-statistical-resources.baseDir>
		<metamac-statistical-resources.etcDir>${metamac-statistical-resources.baseDir}/etc</metamac-statistical-resources.etcDir>

        <!-- EDATOS DATASET REPOSITORY -->
        <edatos-dataset-repository.version>3.7.0</edatos-dataset-repository.version>
        
		<statistic-parser.version>2.1.0</statistic-parser.version>
		<statistic-sdmx-srm-rest-external-api.version>4.10.0</statistic-sdmx-srm-rest-external-api.version>

		<!-- WEB -->
		<jstl.version>1.2</jstl.version>
		
		<io-github-redouane59-twitter.version>2.23</io-github-redouane59-twitter.version>
		<com-fasterxml-jackson-core.version>2.15.0</com-fasterxml-jackson-core.version>
	</properties>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-release-plugin</artifactId>
					<version>2.5</version>
					<configuration>
						<checkModificationExcludes>
							<checkModificationExclude>etc/db/statistical-resources/postgresql/01-create/01-statistical-resources-schema-create.sql</checkModificationExclude>
							<checkModificationExclude>etc/db/statistical-resources/postgresql/02-drop/01-statistical-resources-schema-drop.sql</checkModificationExclude>
						</checkModificationExcludes>
					</configuration>
				</plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
