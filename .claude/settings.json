{
  "permissions": {
    "deny": [
      "Read(**/[Ee][Nn][Vv][Ii][Rr][Oo][Nn][Mm][Ee][Nn][Tt]*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/application-prod.*)",
      "Read(**/application-pre.*)",
      "Read(**/credentials)",
      "Read(**/password)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rm -rf:*)",
      "Bash(docker run:*)",
      "Bash(kubectl:*)",
      "Bash(chmod 777:*)"
    ]
  }
}
