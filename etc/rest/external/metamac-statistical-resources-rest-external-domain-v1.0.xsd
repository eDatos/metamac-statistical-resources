<?xml version="1.0" encoding="UTF-8"?>
<xs:schema version="1.0"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           targetNamespace="http://www.siemac.org/metamac/rest/statistical-resources/v1.0/domain"
           xmlns:tns="http://www.siemac.org/metamac/rest/statistical-resources/v1.0/domain"
           xmlns:common="http://www.siemac.org/metamac/rest/common/v1.0/domain"
           xmlns:common-tns="http://www.siemac.org/metamac/statistical-resources/rest/common/v1.0/domain">

    <xs:import namespace="http://www.siemac.org/metamac/rest/common/v1.0/domain" schemaLocation="metamac-rest-api:metamac-rest-common-domain-v1.0.xsd" />
    <xs:import namespace="http://www.siemac.org/metamac/statistical-resources/rest/common/v1.0/domain" schemaLocation="metamac-statistical-resources-rest-api-common-domain-v1.0.xsd" />

	<xs:complexType name="Dataset">
		<xs:complexContent>
			<xs:extension base="common-tns:DatasetBase">
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="Collection">
		<xs:complexContent>
			<xs:extension base="common-tns:CollectionBase">
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="Query">
		<xs:complexContent>
			<xs:extension base="common-tns:QueryBase">
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="Multidataset">
		<xs:complexContent>
			<xs:extension base="common-tns:MultidatasetBase">	
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	
	<xs:complexType name="DatasetMetadata">
		<xs:complexContent>
			<xs:extension base="common-tns:DatasetMetadataBase">
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="CollectionMetadata">
		<xs:complexContent>
			<xs:extension base="common-tns:CollectionMetadataBase">
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="MultidatasetMetadata">
		<xs:complexContent>
			<xs:extension base="common-tns:MultidatasetMetadataBase">
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="QueryMetadata">
		<xs:complexContent>
			<xs:extension base="common-tns:QueryMetadataBase">
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

  <!-- Elements -->
    <xs:element name="dataset" type="tns:Dataset" />
    <xs:element name="collection" type="tns:Collection" />
    <xs:element name="query" type="tns:Query" />
</xs:schema>
